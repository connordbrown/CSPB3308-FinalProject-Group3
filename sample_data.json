{
  "_about": {
    "description": "Sample data for the Prospex SQLite database (Milestone 5). This '_about' section is documentation only: JSON has no comments, so it is stored under a reserved key that loaders must skip. The four keys after it (users, companies, jobs, contacts) hold the actual table rows.",
    "how_to_read": {
      "structure": "Each table key holds a list of row objects. Each object's keys are the column names.",
      "insert_order": [
        "users",
        "companies",
        "jobs",
        "contacts"
      ],
      "insert_order_reason": "Parents before children, so foreign keys always point to rows that already exist.",
      "ids": "Every row has an explicit integer 'id'. Foreign keys (user_id, company_id, job_id) refer to these ids.",
      "nulls": "A JSON null means the nullable column is empty (SQL NULL).",
      "dates": "date_applied is date-only 'YYYY-MM-DD'. created_at is 'YYYY-MM-DD HH:MM:SS'.",
      "text_fields": "phone is stored as text so +, dashes, parentheses, and spaces are kept.",
      "demo_password": "All three demo users log in with 'DemoPass123!'. Each password_hash is a separate Werkzeug hash.",
      "ownership": "Every row in companies, jobs, and contacts belongs to one user via user_id. The data is kept consistent per user (a job never uses another user's company).",
      "expanding": "To add rows, append to the table's list with the next unused id. Add parents before children and keep emails lowercase."
    },
    "tables": {
      "users": {
        "fields": {
          "id": "INTEGER, primary key",
          "name": "TEXT, NOT NULL, the user's display name",
          "email": "TEXT, NOT NULL, UNIQUE, lowercase",
          "password_hash": "TEXT, NOT NULL, Werkzeug password hash",
          "created_at": "TIMESTAMP, NOT NULL"
        }
      },
      "companies": {
        "fields": {
          "id": "INTEGER, primary key",
          "user_id": "INTEGER, NOT NULL, FK -> users.id",
          "name": "TEXT, NOT NULL, unique per user",
          "city": "TEXT, nullable",
          "region": "TEXT, nullable, state, province, or country",
          "website": "TEXT, nullable",
          "notes": "TEXT, nullable"
        }
      },
      "jobs": {
        "fields": {
          "id": "INTEGER, primary key",
          "user_id": "INTEGER, NOT NULL, FK -> users.id",
          "company_id": "INTEGER, NOT NULL, FK -> companies.id",
          "title": "TEXT, NOT NULL",
          "link": "TEXT, nullable, URL of the job post",
          "work_type": "TEXT, nullable, one of: remote, hybrid, in person",
          "notes": "TEXT, nullable",
          "status": "TEXT, NOT NULL, default 'saved', one of: saved, applied, interviewing, offer, rejected, accepted, declined, withdrawn",
          "date_applied": "DATE, nullable, set manually by the user",
          "created_at": "TIMESTAMP, NOT NULL"
        }
      },
      "contacts": {
        "fields": {
          "id": "INTEGER, primary key",
          "user_id": "INTEGER, NOT NULL, FK -> users.id",
          "company_id": "INTEGER, nullable, FK -> companies.id",
          "job_id": "INTEGER, nullable, FK -> jobs.id (cleared if the job is deleted)",
          "name": "TEXT, NOT NULL",
          "title": "TEXT, nullable, the contact's own job title",
          "designation": "TEXT, nullable, one of: recruiter, referrer, interviewer, hiring manager, other",
          "email": "TEXT, nullable, not unique",
          "phone": "TEXT, nullable",
          "linkedin_url": "TEXT, nullable",
          "notes": "TEXT, nullable"
        }
      }
    }
  },
